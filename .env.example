# Copy to .env and fill in for lab deployment

# Database (required)
DATABASE_URL=postgresql://user:password@localhost:5432/dev_seedworks_db

# Copernicus / Sentinel Hub (required for ingestion)
SH_CLIENT_ID=
SH_CLIENT_SECRET=

# Optional: repo root override
# SATELLITE_PROJECT_ROOT=/opt/SeedIQ-Prod
# SATELLITE_KML_DIR=data/kml/harvest_all_fields
# SATELLITE_MAPPING_DIR=data/mapping

# S2 cloud defaults
S2_MAX_CLOUD_COVER=60
S2_MIN_VALID_PIXEL_PCT=30

# Logging
LOG_LEVEL=INFO
